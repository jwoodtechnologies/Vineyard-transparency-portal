  "crawlPolicy": {
    "defaultMaxDepth": 2,
    "requestDelayMs": 1500,
    "maxCrawlDelayMs": 30000,
    "userAgent": "VineyardTransparencyPortalBot/0.1 (independent public-records archive; +https://example.invalid/replace-with-project-contact-page)",
    "robotsUserAgentToken": "VineyardTransparencyPortalBot",
    "respectRobotsTxt": true,
    "timeoutMs": 20000,
    "maxRetries": 2,
    "maxRedirects": 10,
    "maxHtmlBytes": 5000000,
    "maxDocumentBytes": 200000000,
    "maxPagesPerRun": 300,
    "maxQueryVariantsPerPath": 5,
    "stripQueryParams": ["utm_*", "fbclid", "gclid", "dclid", "gbraid", "wbraid", "msclkid", "mc_cid", "mc_eid", "_ga", "_gl", "igshid", "yclid", "_hsenc", "_hsmi"],
    "skipUrlPatterns": [
      "/(login|signin|sign-in|logout|myaccount|my-account|register)(/|\\.|\\?|$)",
      "[?&](print|share|sharethis)=",
      "/calendar\\.aspx",
      "/search(\\.aspx)?(/|\\?|$)",
      "/(rss|feed)(\\.aspx)?(/|\\?|$)",
      "/formcenter/",
      "/notifyme",
      "\\.(css|js|mjs|ico|svg|woff2?|ttf|eot|map)(\\?|$)"
    ],
    "relevantKeywords": [
      "transparen", "agenda", "minutes", "meeting", "council", "commission", "board", "committee",
      "ordinance", "resolution", "budget", "finance", "financial", "audit", "notice", "hearing",
      "document", "archive", "record", "grama", "code", "planning", "zoning", "report", "contract",
      "bid", "rfp", "procurement", "fee", "plan", "study", "redevelopment", "legislat"
    ],
    "probeDocuments": true,
    "maxDocumentProbes": 500
  },
