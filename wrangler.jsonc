// Vineyard Transparency Portal: one Cloudflare Worker serving the SPA (static assets) and /api/*.
// Workers Paid ($5/month, shared with the owner's other projects): every setting below stays inside
// the plan's included usage, zero overage. See docs/FREE_TIER_LIMITS.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vineyard-transparency-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Keep variables set in the Cloudflare dashboard (MAPILLARY_TOKEN, GOOGLE_MAPS_KEY, GOOGLE_SV_DAILY_CAP) when deploying.
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/documents/:id, /search?...) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* executes Worker code; everything else is served directly from the asset store.
    "run_worker_first": ["/api/*", "/feeds/*"]
  },
  // The deployed version's id (env.CF_VERSION_METADATA.id): edge cached API copies and stored page payloads are
  // keyed to it, so a deploy never serves a copy computed by the code it replaced (worker/lib/edgeCache.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Migration SQL is bundled as text so the Worker can apply it (POST /api/admin/migrate).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "CATALOG_DB", "database_name": "vtp-catalog", "database_id": "8ae24e53-356b-4eda-8ca5-b232c563dc89", "migrations_dir": "migrations/catalog" },
    { "binding": "SEARCH_DB_0", "database_name": "vtp-search-0", "database_id": "004f3149-ccba-46e3-b041-fbb2925ac00b", "migrations_dir": "migrations/search" },
    { "binding": "SEARCH_DB_1", "database_name": "vtp-search-1", "database_id": "b914c1ff-2d33-4973-a475-09dd4188bc75", "migrations_dir": "migrations/search" }
    // Add SEARCH_DB_1..7 here when shard 0 approaches ~400 MB (docs/SEARCH.md), then list them in SEARCH_SHARDS.
  ],
  // Standard storage class bucket. Uploads stop at ARCHIVE_STORAGE_HARD_STOP_BYTES (never past ARCHIVE_STORAGE_CEILING_BYTES).
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "vtp-public-records" }],
  // Workers AI on Workers Paid: 10,000 Neurons/day included, shared with the account's other projects.
  // Use above that is billed, so worker/ai/meter.ts keeps this Worker's total at or under 10,000.
  "ai": { "binding": "AI" },
  "vars": {
    "SEARCH_SHARDS": "0,1",
    "SEARCH_WRITE_SHARDS": "0,1",
    "AI_ENABLED": "true",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "AI_MAX_REQUESTS_PER_DAY": "220",
    "AI_BIG_PER_DAY": "35",
    // Hard caps on estimated Workers AI Neurons per UTC day, by spender (worker/ai/meter.ts). Residents
    // get 9,000; the chat suite (requests with x-vtp-suite: 1) gets 1,000. The sum never passes 10,000.
    "AI_NEURONS_PUBLIC_PER_DAY": "9000",
    "AI_NEURONS_TESTS_PER_DAY": "1000",
    // D1 storage included: 5 GB per account. Two shards at 2 GB leave room for the catalog and other projects.
    "SEARCH_SHARD_MAX_BYTES": "2000000000",
    // D1 rows written included: 50 million per month per account. 1 million a day leaves room for other projects.
    "MAX_D1_INGEST_ROWS_PER_DAY": "1000000",
    // R2 storage included: 10 GB-month per account, every bucket together. The owner approved storing every public
    // record file past that on 2026-10-12 (about 37 GB then). The stop is 60 GB and can never pass the ceiling:
    // at $0.015 per GB-month beyond the free 10 GB, a full 60 GB bucket costs about $0.75 a month, the worst case.
    "ARCHIVE_STORAGE_HARD_STOP_BYTES": "60000000000",
    "ARCHIVE_STORAGE_CEILING_BYTES": "60000000000",
    // Other files (packets, staff reports, slides) stop 0.5 GB earlier so new minutes, agendas and ordinances find room.
    "ARCHIVE_PRIORITY_RESERVE_BYTES": "500000000",
    // The other buckets' size, for the storage cost estimate (GET /api/admin/archive/remaining) only.
    "R2_OTHER_BUCKETS_BYTES": "1700000000",
    // Files up to 25 MiB go up in one request; larger ones in 20 MiB parts (R2 multipart), up to 500 MB.
    "ARCHIVE_MAX_OBJECT_BYTES": "26214400",
    "ARCHIVE_MAX_LARGE_OBJECT_BYTES": "500000000",
    "OIDC_AUDIENCE": "vineyardportal.org",
    "OIDC_REPOSITORY": "jwoodtechnologies/Vineyard-transparency-portal",
    "OIDC_ALLOWED_REFS": "refs/heads/main"
  },
  // Every five minutes: CivicClerk, city pages, Utah public notices, the events calendar and the file
  // queue (worker/cron.ts, worker/sync/run.ts); news once an hour.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Workers Paid: allow up to 2 minutes of CPU for a tick that extracts a long PDF (billed CPU stays
  // far inside the 30 million CPU-ms included each month; most ticks use well under a second).
  "limits": { "cpu_ms": 120000 },
  "observability": { "enabled": true }
}
