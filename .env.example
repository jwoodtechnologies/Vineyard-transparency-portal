# Data mode for the frontend:
# mock -> built-in, clearly labeled demo records (no backend required)
# api -> the archive API in worker/ (production uses api; see .env.production)
VITE_DATA_MODE=mock

# Base URL for the production API when VITE_DATA_MODE=api.
# Leave empty to use same-origin /api (served by the Cloudflare Worker in worker/).
VITE_API_BASE_URL=

# Request timeout for API calls in milliseconds.
VITE_API_TIMEOUT_MS=20000

# ---- Ingestion CLI (python -m ingest / npm run ingest) ----
# Comma-separated API origins, first healthy one wins.
VTP_API_BASE=https://vineyardportal.org,https://vineyard-transparency-portal.citizenjwood.workers.dev
# Only for running ingestion from a local machine. In GitHub Actions, OIDC is used and no token exists.
# Set the same value as a Worker secret:  npx wrangler secret put INGEST_TOKEN   (>= 32 random characters)
VTP_INGEST_TOKEN=
# Optional: keep archived copies on disk instead of R2 (development).
VTP_LOCAL_ARCHIVE_DIR=
