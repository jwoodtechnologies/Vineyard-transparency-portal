# Data mode for the frontend:
#   mock -> built-in, clearly labeled demo records (no backend required)
#   api  -> Phase 2 backend implementing docs/API_CONTRACT.md
VITE_DATA_MODE=mock

# Base URL for the production API when VITE_DATA_MODE=api.
# Leave empty to use same-origin /api (served by the Cloudflare Worker in worker/).
VITE_API_BASE_URL=

# Request timeout for API calls in milliseconds.
VITE_API_TIMEOUT_MS=20000
