[{"page":1,"text":"ORDINANCE 2026-10\n\nAN ORDINANCE AMENDING THE VINEYARD CITY BUDGET FOR THE 2026-2027\n\nFISCAL YEAR.\nWHEREAS, the City Council of Vineyard, Utah has previously adopted a budget for the\n2026-2027 fiscal year in accordance with the Utah Fiscal Procedures Act for cities; and\n\nWHEREAS, the city needs to now amend that adopted budget; and\nWHEREAS, a public hearing was held on the 25th day of August 2026, on the proposed\namendments to the 2026-2027 fiscal year budget for the city of Vineyard, Utah.\n\nNOW THEREFORE BE IT RESOLVED BY THE VINEYARD CITY COUNCIL\n\nAS FOLLOWS:\n1. The attached exhibit A shows the amendments to the Fiscal Year 2026-2027 budget\nfor the city of Vineyard, Utah.\n\n2. This resolution shall take effect upon passing.\n\nPassed and dated this 25th day of August 2026.\n\nATTEST:\n\n___________________________________\n\nParker McCumber\n\nMayor Pro Tem, Vineyard City\n\n___________________________________\n\nRobin Bond\n\nCity Recorder, Vineyard City\n\nSEAL","ocr":false},{"page":2,"text":"Jacob Holdaway\n\nDavid Lauret\n\nParker McCumber\n\nEzra Nair\n\nJacob Wood\n\nYES\n\nNO\n\nABSENT\n\nABSTAIN\n\n_____\n_____\n_____\n_____\n_____\n\n_____\n_____\n_____\n_____\n_____\n\n_______\n_______\n_______\n_______\n_______\n\n________\n________\n________\n________\n________","ocr":false},{"page":3,"text":"EXHIBIT A","ocr":false}]