	<header>

		<div id="trafficAlert" class="notice-alert banner hidden" role="alertdialog" aria-labelledby="trafficAlert--heading">
			<div class="banner-header">
				<h4 id="trafficAlert--heading"><a href="https://www.udottraffic.utah.gov/List/Alerts" id="trafficAlert--details">Traffic Alert. View Details.</a></h4>
				<button id="trafficAlert--close" aria-label="Close traffic alert">Close</button>
