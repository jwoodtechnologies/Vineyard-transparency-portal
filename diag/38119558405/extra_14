     <script>
      document.addEventListener("DOMContentLoaded", function () {
          const hamburger = document.getElementById('hamburger-menu');
          const mainMenuList = document.getElementById('main-menu-list');
          const menuItems = document.querySelectorAll('.menu-item');

          if (hamburger && mainMenuList) {
              hamburger.addEventListener('click', () => {
                  console.log("Hamburger clicked!");
                  mainMenuList.classList.toggle('active');
              });
          }

          const activeMenu = sessionStorage.getItem('activeMenu');
          if (activeMenu) {
              const activeItem = document.querySelector(`.menu-item a[href='${activeMenu}']`);
              if (activeItem) {
                  activeItem.classList.add('active');
              }
          }

          function updateMenuActiveState(clickedHref) {
              menuItems.forEach(item => {
                  item.querySelector('a').classList.remove('active');
              });

              const clickedItem = document.querySelector(`.menu-item a[href='${clickedHref}']`);
              if (clickedItem) {
                  clickedItem.classList.add('active');
                  sessionStorage.setItem('activeMenu', clickedHref);
              }
          }

          menuItems.forEach(item => {
              const itemLink = item.querySelector('a');

              item.addEventListener('mouseenter', () => {
                  if (window.innerWidth > 1014) {
                      const submenu = item.querySelector('.sub-menu');
                      if (submenu) submenu.classList.add('active');
                  }
              });

              item.addEventListener('mouseleave', () => {
                  if (window.innerWidth > 1014) {
                      const submenu = item.querySelector('.sub-menu');
                      if (submenu) submenu.classList.remove('active');
                  }
              });

              itemLink.addEventListener('click', (e) => {
                  if (window.innerWidth <= 1014) {
                      e.preventDefault(); 
                      const submenu = item.querySelector('.sub-menu');

                      if (submenu) {
                          if (submenu.classList.contains('active')) {
                              submenu.classList.remove('active');
                          } else {
                              document.querySelectorAll('.sub-menu').forEach(sub => sub.classList.remove('active'));
                              submenu.classList.add('active');
                          }
                      }
                  } else {
                      updateMenuActiveState(itemLink.getAttribute('href'));
                  }
              });

              const nestedMenuItems = item.querySelectorAll('.menu-item');
              nestedMenuItems.forEach(nestedItem => {
                  const nestedLink = nestedItem.querySelector('a');

                  nestedItem.addEventListener('mouseenter', () => {
                      if (window.innerWidth > 1014) {
                          const nestedSubMenu = nestedItem.querySelector('.sub-menu');
                          if (nestedSubMenu) nestedSubMenu.classList.add('active');
                      }
                  });

                  nestedItem.addEventListener('mouseleave', () => {
                      if (window.innerWidth > 1014) {
                          const nestedSubMenu = nestedItem.querySelector('.sub-menu');
                          if (nestedSubMenu) nestedSubMenu.classList.remove('active');
                      }
                  });

                  nestedLink.addEventListener('click', (e) => {
                      if (window.innerWidth <= 1014) {
                          e.preventDefault();
                          const nestedSubMenu = nestedItem.querySelector('.sub-menu');

                          if (nestedSubMenu) {
                              if (nestedSubMenu.classList.contains('active')) {
                                  nestedSubMenu.classList.remove('active');
                              } else {
                                  document.querySelectorAll('.sub-menu').forEach(sub => sub.classList.remove('active'));
                                  nestedSubMenu.classList.add('active');
                              }
                          }
                      }
                  });
              });
          });
      });
     </script>
