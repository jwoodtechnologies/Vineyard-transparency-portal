<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>404 Error - Utah County Government</title>
	<meta name="description" content="Page not found" />
	<style>
		*, *::before, *::after { box-sizing: border-box; }
		body { margin: 0; font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: #111827; background: #f9fafb; }
		.wrap { min-height: 100vh; display: flex; flex-direction: column; }
		.topbar {
			background: #ffffff;
			border-bottom: 1px solid #e5e7eb;
			box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
			padding: 0 1rem;
		}
		.topbar-inner {
			max-width: 72rem;
			margin: 0 auto;
			min-height: 4.5rem;
			display: flex;
			align-items: center;
			justify-content: flex-start;
		}
		.brand { display: inline-flex; align-items: center; }
		.brand img { height: 2.2rem; width: auto; display: block; }
		.hero {
			position: relative;
			min-height: 42vh;
			padding: 2.5rem 1.5rem 4rem;
			background-image: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.5) 45%, rgba(0, 0, 0, 0.2) 100%), url('/error-export/hero.webp');
			background-size: cover;
			background-position: center;
		}
		.hero-inner { max-width: 72rem; margin: 0 auto; padding-top: 2rem; }
		.hero h1 {
			margin: 0;
			font-family: Georgia, 'Times New Roman', serif;
			font-size: clamp(2.25rem, 5vw, 3.75rem);
			font-weight: 600;
			line-height: 1.1;
			color: #fff;
			text-shadow: 0 1px 2px rgba(0,0,0,0.35);
		}
		.breadcrumb-bar {
			background: #f3f4f6;
			border-top: 1px solid #e5e7eb;
			border-bottom: 1px solid #e5e7eb;
		}
		.breadcrumb-inner {
			max-width: 72rem;
			margin: 0 auto;
			padding: 0.75rem 1.5rem;
			font-size: 0.875rem;
			color: #4b5563;
		}
		.breadcrumb-inner a { color: #4b5563; text-decoration: none; }
		.breadcrumb-inner a:hover { text-decoration: underline; }
		.sep { margin: 0 0.5rem; color: #9ca3af; }
		main {
			flex: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 4.5rem 1.5rem 6.5rem;
		}
		.card { text-align: center; max-width: 36rem; }
		.card h2 {
			margin: 0;
			font-family: Georgia, 'Times New Roman', serif;
			font-size: clamp(1.75rem, 4vw, 2.5rem);
			font-weight: 600;
			letter-spacing: -0.025em;
			color: #111827;
		}
		.card p { margin: 1.5rem 0 0; font-size: 1.125rem; line-height: 1.625; color: #374151; }
		.btn {
			display: inline-block;
			margin-top: 2.5rem;
			padding: 0.75rem 2rem;
			font-size: 1rem;
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: 0.015em;
			color: #e2e8f0;
			background: #334155;
			border-radius: 0.375rem;
			text-decoration: none;
			box-shadow: 0 1px 2px rgba(0,0,0,0.08);
		}
		.btn:hover { background: #1e293b; color: #f1f5f9; }
		.btn:focus-visible { outline: 2px solid #64748b; outline-offset: 2px; }
		.footer {
			background: #0f172a;
			border-top: 1px solid rgba(255, 255, 255, 0.1);
			padding: 1.5rem 1rem;
		}
		.footer-inner {
			max-width: 72rem;
			margin: 0 auto;
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			text-align: center;
			row-gap: 0.75rem;
		}
		.footer-inner > * {
			font-size: 0.875rem;
			color: #d1d5db;
			padding: 0 1rem;
		}
		.footer-inner a { text-decoration: none; color: #d1d5db; }
		.footer-inner a:hover { color: #ffffff; }
		.footer-inner .divider { border-left: 1px solid #6b7280; }
		.footer-inner .copyright {
			flex-basis: 100%;
			padding-top: 0.5rem;
		}
		@media (min-width: 640px) {
			.footer-inner .copyright {
				flex-basis: auto;
				padding-top: 0;
			}
		}
	</style>
</head>
<body>
	<div class="wrap">
		<div class="topbar">
			<div class="topbar-inner">
				<a class="brand" href="https://www.utahcounty.gov/" aria-label="Utah County home">
					<img src="/error-export/logo.svg" alt="Utah County" />
				</a>
			</div>
		</div>
		<header class="hero">
			<div class="hero-inner">
				<h1>404 Error</h1>
			</div>
		</header>
		<div class="breadcrumb-bar" aria-label="Breadcrumb">
			<div class="breadcrumb-inner">
				<a href="https://www.utahcounty.gov/">Home</a><span class="sep">&rsaquo;</span><span>404 Error</span>
			</div>
		</div>
		<main>
			<div class="card">
				<h2>Page not found</h2>
				<p>Sorry, we couldn&rsquo;t find the page you&rsquo;re looking for.</p>
				<a class="btn" href="https://www.utahcounty.gov/">Go back home</a>
			</div>
		</main>
		<footer class="footer">
			<div class="footer-inner">
			<p>
				<a target="_blank" rel="noopener" href="https://www.utahcounty.gov/disclaimer.html">Privacy Policy</a> |
				<a target="_blank" rel="noopener" href="https://www.utahcounty.gov/disclaimer.html">Terms of Use</a>
			</p>
				
				<p class="copyright">Copyright &copy; 2026 Utah County Government - All rights reserved</p>
			</div>
		</footer>
	</div>
	<script src="/error-export/qualtricsDeployCode.js"></script>
	<script src="/error-export/posthog-init.js"></script>
</body>
</html>
