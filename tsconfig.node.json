{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts", "tests"],
  "exclude": ["tests/worker-ask-followup.test.ts", "tests/worker-ask-meeting-votes.test.ts", "tests/worker-ask-measure-votes.test.ts", "tests/worker-ask-prior-records.test.ts", "tests/worker-current-rate-ura.test.ts", "tests/worker-contrib.test.ts", "tests/worker-panel-admin.test.ts", "tests/worker-tax-rate.test.ts", "tests/worker-tax-rate-live.test.ts", "tests/worker-coverage-rss.test.ts", "tests/worker-ask-dated-meeting.test.ts", "tests/worker-ask-lookups.test.ts", "tests/worker-job-health.test.ts", "tests/worker-redirects.test.ts", "tests/worker-meeting-place.test.ts", "tests/worker-orphan-lead.test.ts", "tests/worker-record-picks.test.ts", "tests/worker-ai-meter.test.ts", "tests/worker-archive-fill.test.ts", "tests/worker-trail.test.ts", "tests/helpers"]
}
